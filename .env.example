# Plantilla — copiar a .env.local y completar con valores reales (nunca commitear .env.local).

# Clave de Anthropic (console.anthropic.com) — el servidor la usa para generar las lecturas.
ANTHROPIC_API_KEY=

# Modelo de IA para la generación de lecturas — ver ESTADO.md → Decisiones técnicas.
AI_MODEL=claude-sonnet-5

# Supabase (Project Settings → API) — URL y publishable key son públicas por diseño.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clave service_role de Supabase — SOLO para el panel de admin (crear usuarios a
# mano). NUNCA exponerla al navegador, NUNCA pegarla en el chat. Se usa
# exclusivamente en app/api/admin/usuarios/route.ts, después de verificar que
# quien llama ya es admin.
SUPABASE_SERVICE_ROLE_KEY=
